{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "services": {
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "functions": {
        "**": {
          "maxDuration": 800
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "api"
      }
    }
  ]
}
